generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model obat {
  id              Int         @id @default(autoincrement())
  nama_obat       String      @db.VarChar(100)
  kategori        String      @db.VarChar(50)
  stok            Int
  createdAt       DateTime    @default(now())
  deskripsi       String?     @db.Text
  harga_beli      Float
  harga_jual      Float
  kode_obat       String      @unique(map: "Obat_kode_obat_key") @db.VarChar(20)
  satuan          String      @db.VarChar(20)
  supplier        String      @db.VarChar(100)
  tanggal_expired DateTime
  tanggal_masuk   DateTime    @default(now())
  updatedAt       DateTime    @default(now())
  transaksi       transaksi[]
}

model pelanggan {
  id            Int         @id @default(autoincrement())
  nama          String      @db.VarChar(100)
  alamat        String      @db.Text
  no_hp         String      @db.VarChar(20)
  createdAt     DateTime    @default(now())
  email         String?     @db.VarChar(100)
  jenis_kelamin String      @db.VarChar(20)
  kode_member   String?     @unique(map: "Pelanggan_kode_member_key") @db.VarChar(20)
  updatedAt     DateTime    @default(now())
  transaksi     transaksi[]
}

model transaksi {
  id             Int       @id @default(autoincrement())
  jumlah         Int
  total_harga    Float
  tanggal        DateTime  @default(now())
  obatId         Int
  pelangganId    Int
  harga_satuan   Float
  kode_transaksi String    @unique(map: "Transaksi_kode_transaksi_key") @db.VarChar(30)
  metode_bayar   String    @db.VarChar(30)
  status         String    @default("Selesai")
  obat           obat      @relation(fields: [obatId], references: [id], onDelete: Cascade, map: "Transaksi_obatId_fkey")
  pelanggan      pelanggan @relation(fields: [pelangganId], references: [id], onDelete: Cascade, map: "Transaksi_pelangganId_fkey")

  @@index([obatId], map: "Transaksi_obatId_idx")
  @@index([pelangganId], map: "Transaksi_pelangganId_idx")
}

model users {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name              String    @db.VarChar(255)
  email             String    @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at DateTime? @db.Timestamp(0)
  password          String    @db.VarChar(255)
  remember_token    String?   @db.VarChar(100)
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)
}
